@@ -8,11 +8,28 @@
 #include "mbedtls/rsa.h"
 #include "mbedtls/x509.h"
 
+/* RomMate: fixed DRBG seed so the PSS salt — and therefore the self-signature,
+   the NCA IDs and the final NSP bytes — are deterministic across builds. */
+static const unsigned char fixed_seed[32] = {
+    0x52, 0x6f, 0x6d, 0x4d, 0x61, 0x74, 0x65, 0x01,
+    0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09,
+    0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11,
+    0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19
+};
+
+static int fixed_seed_func(void *data, unsigned char *output, size_t len)
+{
+    const unsigned char *seed = (const unsigned char *)data;
+    size_t i;
+    for (i = 0; i < len; i++)
+        output[i] = seed[i % 32];
+    return 0;
+}
+
 void rsa_sign(void* input, size_t input_size, unsigned char* output, size_t output_size)
 {
     unsigned char hash[32];
